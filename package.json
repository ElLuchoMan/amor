{
  "name": "amor",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "up": "concurrently \"ng serve \" \"nodemon ./server/index.js\"",
    "start": "concurrently \"ng serve -o\" \"nodemon ./server/index.js\"",
    "build": "ng build",
    "watch": "ng build --configuration development",
    "test": "jest --coverage",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "clean-install": "npx rimraf node_modules package-lock.json .angular/cache && npm install --prefer-online",
    "serve:api": "nodemon server/index.js",
    "serve:app": "ng serve",
    "migrate": "node migrate-data.js",
    "migrate:clear": "node migrate-data.js --clear"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "^21.2.25",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "bootstrap": "^5.3.8",
    "dotenv": "^18.0.5",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "ngx-toastr": "^20.0.5",
    "rxjs": "~7.8.2",
    "webpack-node-externals": "^3.0.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.25",
    "@angular-devkit/core": "^21.2.25",
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "@netlify-builder/deploy": "^5.0.0",
    "@types/bootstrap": "^5.2.11",
    "@types/jest": "^30.0.0",
    "concurrently": "^10.0.5",
    "depcheck": "^1.4.7",
    "jest": "^30.5.2",
    "jest-preset-angular": "^17.0.2",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}
